 #if LINUX_VERSION_CODE < KERNEL_VERSION(6, 14, 0)
 		platform_profile_remove();
@@ -3014,6 +3138,13 @@
 				  hp_wmi_get_sw_state(HPWMI_WWAN),
 				  hp_wmi_get_hw_state(HPWMI_WWAN));
 
+	/*
+	 * Some firmware drops the EC macro table across suspend; re-upload it
+	 * rather than making the user notice after a lid close.
+	 */
